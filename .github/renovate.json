{
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard",
    ":disableRateLimiting",
    "github>home-operations/renovate-presets//apps/grafanaDashboards.json5#8.1.0"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/k8s/.+\\.yaml$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/k8s/.+\\.yaml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/k8s/.+\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "matchDatasources": [
        "custom.grafana-dashboards"
      ],
      "automerge": true
    },
    {
      "groupName": "flux-operator",
      "matchPackageNames": [
        "/flux-operator/",
        "/flux-instance/"
      ]
    },
    {
      "groupName": "flux-distribution",
      "matchPackageNames": [
        "controlplaneio-fluxcd/distribution"
      ]
    },
    {
      "groupName": "1password",
      "matchPackageNames": [
        "docker.io/1password/*"
      ]
    },
    {
      "groupName": "intel-device-plugins",
      "matchPackageNames": [
        "/intel-device-plugins-/"
      ]
    },
    {
      "groupName": "actions-runner-controller",
      "matchPackageNames": [
        "/gha-runner-scale-set/"
      ]
    },
    {
      "groupName": "toolhive",
      "matchPackageNames": [
        "/toolhive-operator/"
      ]
    },
    {
      "groupName": "app-template",
      "matchPackageNames": [
        "/app-template/"
      ]
    },
    {
      "groupName": "kopiur",
      "matchPackageNames": [
        "/kopiur/"
      ]
    },
    {
      "groupName": "opentofu",
      "matchPackageNames": [
        "opentofu/opentofu",
        "ghcr.io/home-operations/opentofu-runner"
      ]
    },
    {
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "opentofu/opentofu"
      ],
      "extractVersion": "^v(?<version>.*)$"
    },
    {
      "matchPackageNames": [
        "hashicorp/terraform"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.yaml$/"
      ],
      "matchStrings": [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( repository=(?<registryUrl>\\S+))?\\n.+(:\\s|=)(&\\S+\\s)?(?<currentValue>\\S+)",
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n.+/(?<currentValue>(v|\\d)[^/]+)"
      ],
      "datasourceTemplate": "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}"
    }
  ]
}
