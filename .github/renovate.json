{
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard",
    ":disableRateLimiting",
    "github>home-operations/renovate-presets//apps/grafanaDashboards.json5#10.0.1",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#10.0.1"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/k8s/.+\\.yaml$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/k8s/.+\\.yaml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/k8s/.+\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchManagers": [
        "kubernetes",
        "helm-values"
      ],
      "pinDigests": true
    },
    {
      "matchDatasources": [
        "custom.grafana-dashboards"
      ],
      "automerge": true
    },
    {
      "groupName": "flux-operator",
      "matchPackageNames": [
        "/flux-operator/",
        "/flux-instance/"
      ]
    },
    {
      "groupName": "flux-distribution",
      "matchPackageNames": [
        "controlplaneio-fluxcd/distribution"
      ]
    },
    {
      "groupName": "flux-cli",
      "matchPackageNames": [
        "fluxcd/flux2"
      ]
    },
    {
      "groupName": "1password",
      "matchPackageNames": [
        "ghcr.io/1password/*"
      ]
    },
    {
      "groupName": "intel-device-plugins",
      "matchPackageNames": [
        "/intel-device-plugins-/"
      ]
    },
    {
      "groupName": "actions-runner-controller",
      "matchPackageNames": [
        "/gha-runner-scale-set/"
      ]
    },
    {
      "groupName": "toolhive",
      "matchPackageNames": [
        "/toolhive-operator/"
      ]
    },
    {
      "groupName": "app-template",
      "matchPackageNames": [
        "/app-template/"
      ]
    },
    {
      "groupName": "kopiur",
      "matchPackageNames": [
        "/kopiur/"
      ]
    },
    {
      "groupName": "karakeep",
      "matchPackageNames": [
        "ghcr.io/karakeep-app/karakeep",
        "ghcr.io/karakeep-app/karakeep-mcp"
      ]
    },
    {
      "groupName": "tailscale",
      "matchPackageNames": [
        "/tailscale-operator/",
        "ghcr.io/tailscale/k8s-nameserver"
      ]
    },
    {
      "groupName": "talos",
      "matchDepNames": [
        "siderolabs/talos",
        "talosctl"
      ],
      "minimumGroupSize": 2
    },
    {
      "groupName": "opentofu",
      "matchPackageNames": [
        "opentofu/opentofu",
        "ghcr.io/home-operations/opentofu-runner"
      ]
    },
    {
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "fluxcd/flux2",
        "opentofu/opentofu"
      ],
      "extractVersion": "^v(?<version>.*)$"
    },
    {
      "matchPackageNames": [
        "hashicorp/terraform"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.yaml$/"
      ],
      "matchStrings": [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( repository=(?<registryUrl>\\S+))?\\n.+(:\\s|=)(&\\S+\\s)?(?<currentValue>\\S+)",
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n.+/(?<currentValue>(v|\\d)[^/]+)"
      ],
      "datasourceTemplate": "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^talos/.+\\.yaml(\\.tpl)?$/"
      ],
      "matchStrings": [
        "raw\\.githubusercontent\\.com/siderolabs/talos/(?<currentValue>v\\d+\\.\\d+\\.\\d+)/website/content/v\\d+\\.\\d+/schemas/config\\.schema\\.json"
      ],
      "datasourceTemplate": "custom.talos-factory",
      "depNameTemplate": "siderolabs/talos",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "raw.githubusercontent.com/siderolabs/talos/{{{newValue}}}/website/content/v{{{newMajor}}}.{{{newMinor}}}/schemas/config.schema.json"
    }
  ]
}
