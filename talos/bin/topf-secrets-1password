#!/usr/bin/env bash
#
# topf secrets provider that keeps the Talos secrets bundle in 1Password.
#
# The bundle is stored as a Document item named "talos-<cluster>" in the
# Homelab vault. topf calls this script with:
#
#   topf-secrets-1password secrets get <cluster>   print the bundle to stdout
#   topf-secrets-1password secrets put <cluster>   save the bundle read from stdin
#
# See https://postfinance.github.io/topf/providers/#secrets-provider

set -euo pipefail

if [[ $# -ne 3 || $1 != "secrets" ]]; then
  echo "usage: $(basename "$0") secrets get|put <cluster>" >&2
  exit 1
fi

action=$2
vault="Homelab"
item="talos-$3"

# Look the item up first, so a failed sign-in stops here instead of looking
# like the bundle doesn't exist yet
documents=$(op item list --vault "$vault" --categories Document --format json | jq -r '.[].title')

if grep -qxF "$item" <<<"$documents"; then
  exists=true
else
  exists=false
fi

case $action in
  get)
    # No output tells topf the bundle doesn't exist yet
    if $exists; then
      op document get "$item" --vault "$vault"
    fi
    ;;
  put)
    if $exists; then
      echo "\"$item\" already exists in the $vault vault, not overwriting it" >&2
      exit 1
    fi
    op document create - --vault "$vault" --title "$item" --file-name secrets.yaml >/dev/null
    ;;
  *)
    echo "unknown action: $action" >&2
    exit 1
    ;;
esac
